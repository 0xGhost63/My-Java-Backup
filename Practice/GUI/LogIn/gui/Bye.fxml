<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.SceneController">

    <children>
        <!-- Title Label -->
        <Label layoutX="200.0" layoutY="40.0" text="Welcome" textAlignment="CENTER">
            <font>
                <Font name="System Bold Italic" size="24.0"/>
            </font>
        </Label>

        <!-- Base Info Label -->
        <Label fx:id="baseLabel" layoutX="20.0" layoutY="110.0" text="Your Information:"/>

        <!-- Labels for displaying user data -->
        <Label fx:id="showNameLabel" layoutX="140.0" layoutY="150.0" text="Name:"/>
        <Label fx:id="showUsernameLabel" layoutX="140.0" layoutY="200.0" text="Username:"/>
        <Label fx:id="showPasswordLabel" layoutX="140.0" layoutY="250.0" text="Password:"/>
    </children>
</AnchorPane>
