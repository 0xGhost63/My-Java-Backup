<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="420.0" prefWidth="320.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="calculator.Calculations">

    <children>
        <Label fx:id="display"
               layoutX="10" layoutY="10"
               prefHeight="60" prefWidth="300"
               text="0"
               style="-fx-background-color: #dddddd; -fx-alignment: center-right; -fx-padding: 10;">
            <font>
                <Font name="System Bold" size="32"/>
            </font>
        </Label>

        <GridPane layoutX="10" layoutY="80"
                  hgap="10" vgap="10"
                  prefWidth="300" prefHeight="320">

            <Button fx:id="b7" text="7" prefWidth="80" prefHeight="60" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Button fx:id="b8" text="8" prefWidth="80" prefHeight="60" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Button fx:id="b9" text="9" prefWidth="80" prefHeight="60" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <Button fx:id="divide" text="/" prefWidth="80" prefHeight="60" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Button fx:id="b4" text="4" prefWidth="80" prefHeight="60" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Button fx:id="b5" text="5" prefWidth="80" prefHeight="60" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Button fx:id="b6" text="6" prefWidth="80" prefHeight="60" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <Button fx:id="multiply" text="×" prefWidth="80" prefHeight="60" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <Button fx:id="b1" text="1" prefWidth="80" prefHeight="60" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Button fx:id="b2" text="2" prefWidth="80" prefHeight="60" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Button fx:id="b3" text="3" prefWidth="80" prefHeight="60" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <Button fx:id="minus" text="-" prefWidth="80" prefHeight="60" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

            <Button fx:id="b0" text="0" prefWidth="170" prefHeight="60" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2"/>
            <Button fx:id="equals" text="=" prefWidth="80" prefHeight="60" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
            <Button fx:id="plus" text="+" prefWidth="80" prefHeight="60" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

        </GridPane>
    </children>

</AnchorPane>
