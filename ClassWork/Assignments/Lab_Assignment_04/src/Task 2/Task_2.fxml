<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.FlowPane?>

<FlowPane alignment="CENTER" hgap="10.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="180.0" prefWidth="330.0" vgap="10.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Task_Controller">
    <children>
        <Label text="Select Your Semester :)" />
        <RadioButton mnemonicParsing="false" selected="true" text="One">
            <toggleGroup>
                <ToggleGroup fx:id="tg" />
            </toggleGroup>
        </RadioButton>
        <RadioButton mnemonicParsing="false" text="Two" toggleGroup="$tg" />
        <RadioButton mnemonicParsing="false" text="Three" toggleGroup="$tg" />
        <Separator prefWidth="190.0" />
        <Button fx:id="btnConfirm" mnemonicParsing="false" onAction="#onClickHandler" text="Confirm Semester Selection !" />
        <Label fx:id="response" text="No Semester Selected" />

    </children>
</FlowPane>